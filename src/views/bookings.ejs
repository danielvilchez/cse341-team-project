<%- include('./partials/header') %>

<section class="bookings-admin-hero">
    <h1>Bookings Admin</h1>
    <p>Review trip bookings loaded from the bookings API.</p>
</section>

<section class="bookings-admin">
    <p class="bookings-admin-state" id="bookings-loading" role="status" aria-live="polite">
        Loading bookings...
    </p>
    <div class="bookings-admin-state bookings-admin-empty" id="bookings-empty" role="status" hidden>
        No bookings found.
    </div>
    <div class="bookings-admin-state bookings-admin-error" id="bookings-error" role="alert" hidden>
        <p>Unable to load bookings right now. Please try again.</p>
        <button id="bookings-retry" type="button">Retry</button>
    </div>

    <div class="bookings-view-controls" id="bookings-view-controls" role="group" aria-label="Booking display" hidden>
        <button id="bookings-cards-button" type="button" aria-pressed="true">Cards</button>
        <button id="bookings-table-button" type="button" aria-pressed="false">Table</button>
    </div>

    <div id="bookings-cards-view" hidden>
        <div class="bookings-grid" id="bookings-list"></div>
    </div>

    <div class="bookings-table-wrap" id="bookings-table-wrap" hidden>
        <div class="bookings-table-scroll">
            <table class="bookings-table">
                <caption>Bookings</caption>
                <thead>
                    <tr>
                        <th scope="col">Booking ID</th>
                        <th scope="col">Trip</th>
                        <th scope="col">Schedule</th>
                        <th scope="col">Class</th>
                        <th scope="col">Travel day</th>
                        <th scope="col">Passengers</th>
                        <th scope="col">Created</th>
                    </tr>
                </thead>
                <tbody id="bookings-table-list"></tbody>
            </table>
        </div>
    </div>

    <template id="booking-card-template">
        <article class="booking-card">
            <header class="booking-card-header">
                <h2 data-field="booking-id"></h2>
                <span class="booking-ticket-class" data-field="ticket-class"></span>
            </header>

            <p class="booking-trip">
                <strong>Trip:</strong>
                <span data-field="trip"></span>
            </p>

            <dl class="booking-details">
                <div>
                    <dt>Schedule</dt>
                    <dd data-field="schedule"></dd>
                </div>
                <div>
                    <dt>Travel day</dt>
                    <dd data-field="travel-day"></dd>
                </div>
                <div>
                    <dt>Passengers</dt>
                    <dd data-field="passengers"></dd>
                </div>
                <div>
                    <dt>Created</dt>
                    <dd data-field="created"></dd>
                </div>
            </dl>
        </article>
    </template>
</section>

<script src="/js/bookings-admin.js" defer></script>

<%- include('./partials/footer') %>
