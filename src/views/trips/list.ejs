<%- include('../partials/header') %>
<h1><%- title %></h1>

<div id="filters" style="margin-bottom: 2rem; display: flex; gap: 1rem; align-items: center;">
    <div>
        <label for="search-input">Search:</label>
        <input type="text" id="search-input" placeholder="Search trips..." style="padding: 0.25rem;">
    </div>

    <div>
        <label for="region-filter">Region:</label>
        <select id="trip-region-filter">
            <option value="">All Regions</option>
            <% if (typeof regions !== 'undefined') { regions.forEach((region) => { %>
                <option value="<%= region %>"><%= region.charAt(0).toUpperCase() + region.slice(1) %></option>
            <% }); } %>
        </select>
    </div>

    <div>
        <label for="season-filter">Season:</label>
        <select id="trip-season-filter">
            <option value="">Any Season</option>
            <% if (typeof seasons !== 'undefined') { seasons.forEach((season) => { %>
                <option value="<%= season %>"><%= season.charAt(0).toUpperCase() + season.slice(1) %></option>
            <% }); } %>
        </select>
    </div>
    
    <button id="search-btn" type="button" style="padding: 0.25rem 1rem;">Search</button>
</div>

<div class="routes-grid" id="trips-container"></div>


<div id="pagination-controls" style="text-align: center; margin-top: 2rem;">
    <button id="prev-btn" style="padding: 0.5rem 1rem; margin-right: 1rem;">Previous</button>
    <span id="page-info" style="margin: 0 1rem; font-weight: bold;"></span>
    <button id="next-btn" style="padding: 0.5rem 1rem; margin-left: 1rem;">Next</button>
</div>


<template id="trip-template">
    <div class="route-card">
        <div class="route-header">
            <h2 class="route-name"></h2>
            <span class="route-region"></span>
        </div>
        <div class="station-info">
            <div class="station">
                <div class="station-type">From:</div>
                <div class="station-name start-station"></div>
            </div>
            <div class="route-arrow">&#8594;</div>
            <div class="station">
                <div class="station-type">To:</div>
                <div class="station-name end-station"></div>
            </div>
        </div>
        <div class="route-details">
            <div class="detail-item">
                <span class="detail-icon">&#128337;</span>
                <span><span class="detail-label">Duration:</span> <span class="trip-duration"></span></span>
            </div>
            <div class="detail-item">
                <span class="detail-icon">&#128205;</span>
                <span><span class="detail-label">Distance:</span> <span class="trip-distance"></span>km</span>
            </div>
            <div class="detail-item">
                <span class="season-badge"></span>
            </div>
        </div>
        <div class="route-description"></div>
        <div class="highlights">
            <div class="highlights-list"></div>
        </div>
        <div class="route-actions">
            <a href="#" class="view-details-btn">View Details &amp; Book &#8594;</a>
        </div>
    </div>
</template>

<script>
    document.addEventListener('DOMContentLoaded', async () => {
        const container = document.getElementById('trips-container');
        const template = document.getElementById('trip-template');
        const prevBtn = document.getElementById('prev-btn');
        const nextBtn = document.getElementById('next-btn');
        const pageInfo = document.getElementById('page-info');
        
        // Filter elements
        const searchInput = document.getElementById('search-input');
        const regionFilter = document.getElementById('trip-region-filter');
        const seasonFilter = document.getElementById('trip-season-filter');
        const searchBtn = document.getElementById('search-btn');

        let currentPage = 1;
        const limit = 10; 

        async function loadTrips(page) {
            try {
                container.innerHTML = '<p>Loading trips...</p>';
                
                // Build query string based on filter values
                const params = new URLSearchParams({
                    page: page,
                    limit: limit
                });

                if (searchInput.value.trim()) params.append('q', searchInput.value.trim());
                if (regionFilter.value) params.append('region', regionFilter.value);
                if (seasonFilter.value) params.append('season', seasonFilter.value);

                const response = await fetch(`/api/trips?${params.toString()}`);
                if (!response.ok) throw new Error('Failed to fetch trips');
                
                const result = await response.json();
                
                renderTrips(result.data);
                
                currentPage = result.pagination.page;
                pageInfo.textContent = `Page ${currentPage} of ${result.pagination.totalPages || 1}`;
                prevBtn.disabled = !result.pagination.hasPreviousPage;
                nextBtn.disabled = !result.pagination.hasNextPage;

            } catch (error) {
                console.error(error);
                container.innerHTML = '<p>Error loading trips. Please try again later.</p>';
            }
        }

        function renderTrips(tripsToRender) {
            container.innerHTML = ''; 

            if (tripsToRender.length === 0) {
                container.innerHTML = '<p>No trips match your search.</p>';
                return;
            }

            tripsToRender.forEach(trip => {
                const clone = template.content.cloneNode(true);
                
                clone.querySelector('.route-card').classList.add(trip.region || '');
                clone.querySelector('.route-name').textContent = trip.name || 'Unknown Trip';
                clone.querySelector('.route-region').textContent = trip.region || '';
                clone.querySelector('.start-station').textContent = trip.startStation || '';
                clone.querySelector('.end-station').textContent = trip.endStation || '';
                clone.querySelector('.trip-duration').textContent = trip.duration || '';
                clone.querySelector('.trip-distance').textContent = trip.distance || '';
                clone.querySelector('.route-description').textContent = trip.description || '';
                
                const seasonBadge = clone.querySelector('.season-badge');
                if (trip.bestSeason) {
                    seasonBadge.classList.add(`season-${trip.bestSeason}`);
                    seasonBadge.textContent = `Best in ${trip.bestSeason}`;
                }

                const highlightsList = clone.querySelector('.highlights-list');
                if (trip.highlights && trip.highlights.length > 0) {
                    trip.highlights.forEach(highlight => {
                        const span = document.createElement('span');
                        span.className = 'highlight-tag';
                        span.textContent = highlight;
                        highlightsList.appendChild(span);
                    });
                }

                clone.querySelector('.view-details-btn').href = `/trips/${trip.id}`;
                container.appendChild(clone);
            });
        }

        // Event Listeners
        prevBtn.addEventListener('click', () => {
            if (currentPage > 1) loadTrips(currentPage - 1);
        });

        nextBtn.addEventListener('click', () => {
            loadTrips(currentPage + 1);
        });

        // When the user clicks search, or changes a dropdown, reset to page 1 and load
        searchBtn.addEventListener('click', (e) => {
            e.preventDefault(); // Stop page reload
            loadTrips(1);
        });

        // regionFilter.addEventListener('change', (e) => {
        //     e.preventDefault();
        //     loadTrips(1);
        // });

        // seasonFilter.addEventListener('change', (e) => {
        //     e.preventDefault();
        //     loadTrips(1);
        // });
        
        // Allow pressing "Enter" in the search box to search
        searchInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') {
                e.preventDefault(); // Stop page reload
                loadTrips(1);
            }
        });

        // Initial load
        loadTrips(1);
    });
</script>

<%- include('../partials/footer') %>