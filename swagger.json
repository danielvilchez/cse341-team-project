{
  "openapi": "3.0.0",
  "info": {
    "title": "Kizuna Rail",
    "version": "1.0.0",
    "description": "API for managing trips and train schedules in Kizuna Rail"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current server"
    }
  ],
  "paths": {
    "/api/trips": {
      "get": {
        "summary": "Get all trips",
        "tags": [
          "Trips"
        ],
        "responses": {
          "200": {
            "description": "A list of trips"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/trips/{id}": {
      "get": {
        "summary": "Get a single trip by ID",
        "tags": [
          "Trips"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Trip found"
          },
          "404": {
            "description": "Trip not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/trips/{id}/schedules": {
      "get": {
        "summary": "Get schedules for a trip",
        "tags": [
          "Schedules"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "month",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Schedules retrieved successfully"
          },
          "400": {
            "description": "Invalid month"
          },
          "404": {
            "description": "Trip not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {},
  "tags": []
}